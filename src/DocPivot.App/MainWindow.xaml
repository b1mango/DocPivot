<Window x:Class="DocPivot.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:c="clr-namespace:DocPivot.App.Controls"
        xmlns:views="clr-namespace:DocPivot.App.Views"
        Title="文枢 DocPivot"
        Icon="Assets/app-icon-gold.ico"
        Width="1240"
        Height="800"
        MinWidth="960"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowDrop="True"
        Background="{DynamicResource WindowFallbackBrush}"
        Foreground="{DynamicResource T1Brush}"
        FontFamily="{StaticResource UiFont}"
        FontSize="13.5"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="8"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.InputBindings>
        <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding StartProcessingCommand}" />
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding AddFilesCommand}" />
    </Window.InputBindings>

    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="224" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== Sidebar ===== -->
        <Border Grid.Column="0" Background="{DynamicResource SideBrush}">
            <Grid Margin="10,0,10,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="52" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Brand -->
                <StackPanel Margin="8,4,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                    <Border Width="24" Height="24" Background="{DynamicResource AccBrush}" CornerRadius="7">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="{StaticResource SerifFont}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource OnAccBrush}"
                                   Text="枢" />
                    </Border>
                    <TextBlock Margin="9,0,0,1"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource SerifFont}"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Text="文枢" />
                </StackPanel>

                <!-- Tools -->
                <ListBox x:Name="ToolList"
                         Grid.Row="1"
                         Margin="0,6,0,0"
                         AutomationProperties.Name="工具"
                         ItemContainerStyle="{StaticResource NavItem}"
                         ItemsSource="{Binding Tools}"
                         SelectedItem="{Binding SelectedTool, Mode=TwoWay}"
                         Style="{StaticResource BareList}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" ToolTip="{Binding Subtitle}">
                                <c:Icon Data="{Binding Icon, Converter={StaticResource ResourceGeometryConverter}}"
                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                        Size="18" />
                                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Text="{Binding Title}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Recent outputs -->
                <TextBlock Grid.Row="2"
                           Padding="10,18,10,6"
                           Style="{StaticResource SectionLabel}"
                           Text="最近"
                           Visibility="{Binding HasRecentOutputs, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <ScrollViewer Grid.Row="3"
                              Focusable="False"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl AutomationProperties.Name="最近输出" Focusable="False" ItemsSource="{Binding RecentOutputs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button AutomationProperties.Name="{Binding DisplayName}"
                                        Command="{Binding DataContext.OpenRecentOutputCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource SidebarRowButton}"
                                        ToolTip="{Binding ToolTip}">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Command="{Binding PlacementTarget.Tag.OpenRecentOutputCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding}"
                                                      Header="打开">
                                                <MenuItem.Icon>
                                                    <c:Icon Data="{StaticResource PhArrowSquareOutL}" Foreground="{DynamicResource T2Brush}" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Command="{Binding PlacementTarget.Tag.RevealRecentOutputCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding}"
                                                      Header="在文件夹中显示">
                                                <MenuItem.Icon>
                                                    <c:Icon Data="{StaticResource PhFolderOpenL}" Foreground="{DynamicResource T2Brush}" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Command="{Binding PlacementTarget.Tag.RemoveRecentOutputCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding}"
                                                      Header="从列表移除">
                                                <MenuItem.Icon>
                                                    <c:Icon Data="{StaticResource PhXL}" Foreground="{DynamicResource T2Brush}" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                    <Button.Tag>
                                        <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=Window}" />
                                    </Button.Tag>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center" FontSize="13" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1"
                                                   Margin="10,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource T3Brush}"
                                                   Text="{Binding RelativeTimeText}" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Footer -->
                <Grid Grid.Row="4" Margin="0,8,0,0">
                    <Border Height="1" Margin="4,0" VerticalAlignment="Top" Background="{DynamicResource LineBrush}" />
                    <Grid Margin="0,9,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button AutomationProperties.Name="设置"
                                Command="{Binding OpenSettingsCommand}"
                                Style="{StaticResource SidebarFootButton}">
                            <StackPanel Orientation="Horizontal">
                                <c:Icon Data="{StaticResource PhGearSixL}" Size="18" />
                                <TextBlock Margin="9,0,0,0" VerticalAlignment="Center" FontSize="13" Text="设置" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ThemeToggle"
                                Grid.Column="1"
                                AutomationProperties.Name="{Binding Settings.ThemeToggleToolTip}"
                                Command="{Binding Settings.ToggleThemeCommand}"
                                ToolTip="{Binding Settings.ThemeToggleToolTip}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                    <Setter Property="Content">
                                        <Setter.Value>
                                            <c:Icon Data="{StaticResource PhMoonL}" Size="18" />
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Settings.IsDarkTheme}" Value="True">
                                            <Setter Property="Content">
                                                <Setter.Value>
                                                    <c:Icon Data="{StaticResource PhSunL}" Size="18" />
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <!-- ===== Main ===== -->
        <Grid Grid.Column="1" Background="{DynamicResource BgBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Title bar: breadcrumb, tool actions, caption buttons -->
            <Grid Grid.Row="0" Margin="18,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource T2Brush}" Text="{Binding SelectedTool.Title}" />
                    <StackPanel Orientation="Horizontal" Visibility="{Binding HasModeTitle, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <c:Icon Margin="7,1,1,0" Data="{StaticResource PhCaretRightL}" Foreground="{DynamicResource T3Brush}" Size="11" />
                        <ComboBox AutomationProperties.Name="PDF 处理方式"
                                  DisplayMemberPath="Title"
                                  ItemsSource="{Binding PdfToolModes}"
                                  SelectedItem="{Binding SelectedPdfToolMode, Mode=TwoWay}"
                                  Style="{StaticResource CrumbCombo}"
                                  Visibility="{Binding HasPdfModes, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <ComboBox AutomationProperties.Name="Excel 处理方式"
                                  DisplayMemberPath="Title"
                                  ItemsSource="{Binding ExcelToolModes}"
                                  SelectedItem="{Binding SelectedExcelToolMode, Mode=TwoWay}"
                                  Style="{StaticResource CrumbCombo}"
                                  Visibility="{Binding HasExcelModes, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock Margin="6,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="Medium"
                                   Text="{Binding ModeTitle}"
                                   Visibility="{Binding IsBatchRenameTool, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button AutomationProperties.Name="撤销上次重命名"
                            Command="{Binding UndoLastRenameCommand}"
                            Style="{StaticResource IconButton}"
                            ToolTip="撤销上次重命名"
                            Visibility="{Binding HasRenameUndo, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <c:Icon Data="{StaticResource PhArrowCounterClockwiseL}" Size="18" />
                    </Button>
                    <Button AutomationProperties.Name="添加文件"
                            Click="OnAddClick"
                            Style="{StaticResource IconButton}"
                            ToolTip="添加文件  Ctrl O"
                            Visibility="{Binding HasFiles, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <c:Icon Data="{StaticResource PhFolderSimplePlusL}" Size="18" />
                    </Button>
                    <Button AutomationProperties.Name="清空列表"
                            Command="{Binding ClearQueueCommand}"
                            Style="{StaticResource IconButton}"
                            ToolTip="清空列表"
                            Visibility="{Binding HasFiles, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <c:Icon Data="{StaticResource PhTrashSimpleL}" Size="18" />
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Top" Orientation="Horizontal">
                    <Button AutomationProperties.Name="最小化窗口" Click="OnMinimizeClick" Content="&#xE921;" Style="{StaticResource CaptionButton}" />
                    <Button x:Name="MaximizeButton"
                            AutomationProperties.Name="最大化或还原窗口"
                            Click="OnMaximizeClick"
                            Content="&#xE922;"
                            Style="{StaticResource CaptionButton}" />
                    <Button AutomationProperties.Name="关闭窗口" Click="OnCloseClick" Content="&#xE8BB;" Style="{StaticResource CaptionCloseButton}" />
                </StackPanel>
            </Grid>

            <views:WorkspaceView x:Name="Workspace" Grid.Row="1" />

            <views:SettingsView Grid.Row="0"
                                Grid.RowSpan="2"
                                Margin="0,40,0,0"
                                Panel.ZIndex="10"
                                Visibility="{Binding IsSettingsOpen, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <!-- Status toast for messages the page does not already show -->
            <Border x:Name="StatusToast"
                    Grid.Row="1"
                    Margin="0,0,0,112"
                    Padding="14,9"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Panel.ZIndex="20"
                    Background="{DynamicResource ToastBrush}"
                    CornerRadius="10"
                    IsHitTestVisible="False"
                    Opacity="0"
                    Visibility="Collapsed"
                    AutomationProperties.LiveSetting="Polite">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="StatusToastShift" />
                </Border.RenderTransform>
                <TextBlock x:Name="StatusToastText"
                           MaxWidth="520"
                           FontSize="13"
                           Foreground="{DynamicResource ToastTextBrush}"
                           TextTrimming="CharacterEllipsis" />
            </Border>
        </Grid>

        <!-- Whole-window drop target -->
        <Border x:Name="DropOverlay"
                Grid.ColumnSpan="2"
                Panel.ZIndex="50"
                Background="{DynamicResource ScrimBrush}"
                IsHitTestVisible="False"
                Visibility="Collapsed">
            <Grid Margin="16">
                <Rectangle x:Name="DropOverlayStroke"
                           RadiusX="16"
                           RadiusY="16"
                           Stroke="{DynamicResource AccBrush}"
                           StrokeDashArray="6,5"
                           StrokeThickness="1.5" />
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="56"
                            Height="56"
                            HorizontalAlignment="Center"
                            Background="{DynamicResource AccSoftBrush}"
                            CornerRadius="16">
                        <c:Icon x:Name="DropOverlayIcon" HorizontalAlignment="Center" Data="{StaticResource PhTrayArrowDownL}" Foreground="{DynamicResource AccTextBrush}" Size="28" />
                    </Border>
                    <TextBlock x:Name="DropOverlayText"
                               Margin="0,16,0,0"
                               HorizontalAlignment="Center"
                               FontFamily="{StaticResource SerifFont}"
                               FontSize="22"
                               FontWeight="Medium" />
                    <TextBlock x:Name="DropOverlayHint"
                               Margin="0,6,0,0"
                               HorizontalAlignment="Center"
                               Style="{StaticResource Muted}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
