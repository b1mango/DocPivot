<Window x:Class="DocPivot.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:DocPivot.App.Views"
        Title="文枢 DocPivot"
        Icon="Assets/app-icon-gold.ico"
        Width="1360"
        Height="820"
        MinWidth="1060"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#01000000"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource BodyFontFamily}"
        FontSize="13"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46"
                            ResizeBorderThickness="8"
                            GlassFrameThickness="0"
                            CornerRadius="12"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="TrafficLightButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="27" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource ControlFocusVisualStyle}" />
            <Setter Property="FontFamily" Value="{StaticResource IconFontFamily}" />
            <Setter Property="FontSize" Value="8" />
            <Setter Property="Foreground" Value="#B0000000" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Dot"
                                     Width="12"
                                     Height="12"
                                     Fill="{TemplateBinding Background}"
                                     SnapsToDevicePixels="True"
                                     Stroke="#30000000"
                                     StrokeThickness="0.75" />
                            <ContentPresenter x:Name="Glyph"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Opacity="0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Glyph" Property="Opacity" Value="0.78" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Dot" Property="Opacity" Value="0.65" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource WindowOverlayBrush}"
            BorderBrush="{StaticResource BorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="12"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
                <RowDefinition Height="31" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource TitleBarBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="0,0,0,1">
                <Grid Margin="14,0,16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="300" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Background="#FF5F57"
                                AutomationProperties.Name="关闭窗口"
                                Click="OnCloseClick"
                                Content="&#xE711;"
                                Style="{StaticResource TrafficLightButtonStyle}"
                                ToolTip="关闭" />
                        <Button Background="#FEBC2E"
                                AutomationProperties.Name="最小化窗口"
                                Click="OnMinimizeClick"
                                Content="&#xE921;"
                                Style="{StaticResource TrafficLightButtonStyle}"
                                ToolTip="最小化" />
                        <Button Background="#28C840"
                                AutomationProperties.Name="最大化或还原窗口"
                                Click="OnMaximizeClick"
                                Style="{StaticResource TrafficLightButtonStyle}"
                                ToolTip="最大化或还原">
                            <TextBlock x:Name="MaximizeGlyph" Text="&#xE922;" />
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                        <Image Width="20"
                               Height="20"
                               Margin="0,0,8,0"
                               Source="Assets/app-icon-gold.png"
                               VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               RenderOptions.EdgeMode="Aliased" />
                        <TextBlock FontFamily="Microsoft YaHei UI"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Text="文枢" />
                        <TextBlock Margin="8,0,0,0"
                                   FontFamily="Segoe UI"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextTertiaryBrush}"
                                   Text="DOCPIVOT" />
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Orientation="Horizontal" />
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="300" MinWidth="264" MaxWidth="420" />
                </Grid.ColumnDefinitions>

                <views:NavigationRail Grid.Column="0" SettingsRequested="OnSettingsRequested" />
                <views:WorkspaceView Grid.Column="1" />
                <GridSplitter Grid.Column="2"
                              Width="5"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Background="Transparent"
                              Cursor="SizeWE"
                              Focusable="False"
                              ResizeBehavior="PreviousAndNext"
                              ResizeDirection="Columns"
                              ShowsPreview="False">
                    <GridSplitter.Template>
                        <ControlTemplate TargetType="GridSplitter">
                            <Grid Background="Transparent">
                                <Border x:Name="Grip"
                                        Width="1"
                                        HorizontalAlignment="Center"
                                        Background="{StaticResource BorderSubtleBrush}" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Grip" Property="Width" Value="2" />
                                    <Setter TargetName="Grip" Property="Background" Value="{StaticResource BorderStrongBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </GridSplitter.Template>
                </GridSplitter>
                <views:InspectorView Grid.Column="3" />
            </Grid>

            <views:StatusBarView Grid.Row="2" />
        </Grid>
    </Border>
</Window>
