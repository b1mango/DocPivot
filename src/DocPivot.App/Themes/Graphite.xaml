<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Theme: Graphite 石墨. Every brush is looked up with DynamicResource so the theme can switch at runtime. -->
    <sys:Boolean x:Key="IsDarkTheme">True</sys:Boolean>

    <!-- Window chrome: the desk the sheet sits on -->
    <Color x:Key="WindowFallbackColor">#111214</Color>
    <SolidColorBrush x:Key="WindowFallbackBrush" Color="#111214" />
    <Color x:Key="WindowOverlayColor">#111214</Color>
    <SolidColorBrush x:Key="WindowOverlayBrush" Color="#111214" />
    <Color x:Key="TitleBarColor">#111214</Color>
    <SolidColorBrush x:Key="TitleBarBrush" Color="#111214" />
    <Color x:Key="SidebarGlassColor">#111214</Color>
    <SolidColorBrush x:Key="SidebarGlassBrush" Color="#111214" />
    <Color x:Key="InspectorGlassColor">#111214</Color>
    <SolidColorBrush x:Key="InspectorGlassBrush" Color="#111214" />

    <!-- The sheet: main working surface -->
    <Color x:Key="WorkspaceGlassColor">#191A1D</Color>
    <SolidColorBrush x:Key="WorkspaceGlassBrush" Color="#191A1D" />
    <Color x:Key="DropZoneColor">#661F2024</Color>
    <SolidColorBrush x:Key="DropZoneBrush" Color="#661F2024" />
    <Color x:Key="SurfaceGlassColor">#1F2024</Color>
    <SolidColorBrush x:Key="SurfaceGlassBrush" Color="#1F2024" />
    <Color x:Key="SurfaceElevatedColor">#2A2C31</Color>
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="#2A2C31" />
    <Color x:Key="SurfaceHoverColor">#222428</Color>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#222428" />
    <Color x:Key="SurfacePressedColor">#2A2C31</Color>
    <SolidColorBrush x:Key="SurfacePressedBrush" Color="#2A2C31" />
    <Color x:Key="SelectedColor">#24262A</Color>
    <SolidColorBrush x:Key="SelectedBrush" Color="#24262A" />
    <Color x:Key="FieldColor">#121315</Color>
    <SolidColorBrush x:Key="FieldBrush" Color="#121315" />
    <Color x:Key="FieldBorderColor">#1AFFFFFF</Color>
    <SolidColorBrush x:Key="FieldBorderBrush" Color="#1AFFFFFF" />
    <Color x:Key="WellColor">#232529</Color>
    <SolidColorBrush x:Key="WellBrush" Color="#232529" />
    <Color x:Key="FillSubtleColor">#0AFFFFFF</Color>
    <SolidColorBrush x:Key="FillSubtleBrush" Color="#0AFFFFFF" />
    <Color x:Key="FillHoverColor">#14FFFFFF</Color>
    <SolidColorBrush x:Key="FillHoverBrush" Color="#14FFFFFF" />
    <Color x:Key="BorderSubtleColor">#10FFFFFF</Color>
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#10FFFFFF" />
    <Color x:Key="BorderStrongColor">#21FFFFFF</Color>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#21FFFFFF" />

    <!-- Ink -->
    <Color x:Key="TextPrimaryColor">#ECECEE</Color>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#ECECEE" />
    <Color x:Key="TextSecondaryColor">#A2A5AC</Color>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A2A5AC" />
    <Color x:Key="TextTertiaryColor">#6C6F76</Color>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#6C6F76" />

    <!-- Accent: Paper = seal-paste vermilion, Graphite = brass -->
    <Color x:Key="AccentColor">#D8AD62</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="#D8AD62" />
    <Color x:Key="AccentHoverColor">#E4BE7C</Color>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#E4BE7C" />
    <Color x:Key="AccentPressedColor">#C79B51</Color>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#C79B51" />
    <Color x:Key="AccentInkColor">#1A150D</Color>
    <SolidColorBrush x:Key="AccentInkBrush" Color="#1A150D" />
    <Color x:Key="AccentSubtleColor">#1FD8AD62</Color>
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#1FD8AD62" />

    <!-- Semantic -->
    <Color x:Key="SuccessColor">#6FBB8B</Color>
    <SolidColorBrush x:Key="SuccessBrush" Color="#6FBB8B" />
    <Color x:Key="SuccessSubtleColor">#1A6FBB8B</Color>
    <SolidColorBrush x:Key="SuccessSubtleBrush" Color="#1A6FBB8B" />
    <Color x:Key="WarningColor">#E0B04A</Color>
    <SolidColorBrush x:Key="WarningBrush" Color="#E0B04A" />
    <Color x:Key="DangerColor">#E2725F</Color>
    <SolidColorBrush x:Key="DangerBrush" Color="#E2725F" />
    <Color x:Key="DangerSubtleColor">#17E2725F</Color>
    <SolidColorBrush x:Key="DangerSubtleBrush" Color="#17E2725F" />
    <Color x:Key="InfoColor">#7FB6E8</Color>
    <SolidColorBrush x:Key="InfoBrush" Color="#7FB6E8" />
    <Color x:Key="ShadowColor">#66000000</Color>
    <SolidColorBrush x:Key="ShadowBrush" Color="#66000000" />
    <SolidColorBrush x:Key="TransparentBrush" Color="Transparent" />
</ResourceDictionary>
