<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Theme-independent tokens. Colours live in Light.xaml / Dark.xaml. -->

    <!-- Type: Inter for Latin and figures, Noto Sans SC for Chinese, Noto Serif SC for headings. Bundled, so every PC renders the same. -->
    <FontFamily x:Key="UiFont">/DocPivot;component/Assets/Fonts/#Inter, /DocPivot;component/Assets/Fonts/#Noto Sans SC, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="SerifFont">/DocPivot;component/Assets/Fonts/#Noto Serif SC, /DocPivot;component/Assets/Fonts/#Noto Sans SC, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="CaptionGlyphFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <sys:Double x:Key="FontCaption">11.5</sys:Double>
    <sys:Double x:Key="FontSmall">12.5</sys:Double>
    <sys:Double x:Key="FontBody">13.5</sys:Double>
    <sys:Double x:Key="FontName">14</sys:Double>
    <sys:Double x:Key="FontHeading">24</sys:Double>
    <sys:Double x:Key="FontHero">31</sys:Double>

    <!-- Radii -->
    <CornerRadius x:Key="RadiusS">7</CornerRadius>
    <CornerRadius x:Key="RadiusM">9</CornerRadius>
    <CornerRadius x:Key="RadiusL">12</CornerRadius>
    <CornerRadius x:Key="RadiusComposer">20</CornerRadius>

    <!-- Width of the single reading column -->
    <sys:Double x:Key="ColumnWidth">640</sys:Double>

    <!-- Motion: felt, not watched -->
    <Duration x:Key="FadeFast">0:0:0.12</Duration>
    <Duration x:Key="FadeMedium">0:0:0.18</Duration>
    <CubicEase x:Key="EaseOut" EasingMode="EaseOut" />
</ResourceDictionary>
