<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Theme: Paper 纸本. Every brush is looked up with DynamicResource so the theme can switch at runtime. -->
    <sys:Boolean x:Key="IsDarkTheme">False</sys:Boolean>

    <!-- Window chrome: the desk the sheet sits on -->
    <Color x:Key="WindowFallbackColor">#ECE8E1</Color>
    <SolidColorBrush x:Key="WindowFallbackBrush" Color="#ECE8E1" />
    <Color x:Key="WindowOverlayColor">#ECE8E1</Color>
    <SolidColorBrush x:Key="WindowOverlayBrush" Color="#ECE8E1" />
    <Color x:Key="TitleBarColor">#ECE8E1</Color>
    <SolidColorBrush x:Key="TitleBarBrush" Color="#ECE8E1" />
    <Color x:Key="SidebarGlassColor">#ECE8E1</Color>
    <SolidColorBrush x:Key="SidebarGlassBrush" Color="#ECE8E1" />
    <Color x:Key="InspectorGlassColor">#ECE8E1</Color>
    <SolidColorBrush x:Key="InspectorGlassBrush" Color="#ECE8E1" />

    <!-- The sheet: main working surface -->
    <Color x:Key="WorkspaceGlassColor">#FBFAF7</Color>
    <SolidColorBrush x:Key="WorkspaceGlassBrush" Color="#FBFAF7" />
    <Color x:Key="DropZoneColor">#B3FFFFFF</Color>
    <SolidColorBrush x:Key="DropZoneBrush" Color="#B3FFFFFF" />
    <Color x:Key="SurfaceGlassColor">#FFFFFF</Color>
    <SolidColorBrush x:Key="SurfaceGlassBrush" Color="#FFFFFF" />
    <Color x:Key="SurfaceElevatedColor">#FFFFFF</Color>
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="#FFFFFF" />
    <Color x:Key="SurfaceHoverColor">#F3F0EA</Color>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#F3F0EA" />
    <Color x:Key="SurfacePressedColor">#EAE6DE</Color>
    <SolidColorBrush x:Key="SurfacePressedBrush" Color="#EAE6DE" />
    <Color x:Key="SelectedColor">#E2DDD3</Color>
    <SolidColorBrush x:Key="SelectedBrush" Color="#E2DDD3" />
    <Color x:Key="FieldColor">#FFFFFF</Color>
    <SolidColorBrush x:Key="FieldBrush" Color="#FFFFFF" />
    <Color x:Key="FieldBorderColor">#29281F14</Color>
    <SolidColorBrush x:Key="FieldBorderBrush" Color="#29281F14" />
    <Color x:Key="WellColor">#EFEBE4</Color>
    <SolidColorBrush x:Key="WellBrush" Color="#EFEBE4" />
    <Color x:Key="FillSubtleColor">#0D281F14</Color>
    <SolidColorBrush x:Key="FillSubtleBrush" Color="#0D281F14" />
    <Color x:Key="FillHoverColor">#17281F14</Color>
    <SolidColorBrush x:Key="FillHoverBrush" Color="#17281F14" />
    <Color x:Key="BorderSubtleColor">#17281F14</Color>
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#17281F14" />
    <Color x:Key="BorderStrongColor">#2E281F14</Color>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#2E281F14" />

    <!-- Ink -->
    <Color x:Key="TextPrimaryColor">#22201C</Color>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#22201C" />
    <Color x:Key="TextSecondaryColor">#625D55</Color>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#625D55" />
    <Color x:Key="TextTertiaryColor">#9A948A</Color>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#9A948A" />

    <!-- Accent: Paper = seal-paste vermilion, Graphite = brass -->
    <Color x:Key="AccentColor">#B0412D</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="#B0412D" />
    <Color x:Key="AccentHoverColor">#9C3725</Color>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#9C3725" />
    <Color x:Key="AccentPressedColor">#872F1F</Color>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#872F1F" />
    <Color x:Key="AccentInkColor">#FFF9F5</Color>
    <SolidColorBrush x:Key="AccentInkBrush" Color="#FFF9F5" />
    <Color x:Key="AccentSubtleColor">#17B0412D</Color>
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#17B0412D" />

    <!-- Semantic -->
    <Color x:Key="SuccessColor">#3B7553</Color>
    <SolidColorBrush x:Key="SuccessBrush" Color="#3B7553" />
    <Color x:Key="SuccessSubtleColor">#143B7553</Color>
    <SolidColorBrush x:Key="SuccessSubtleBrush" Color="#143B7553" />
    <Color x:Key="WarningColor">#A86A12</Color>
    <SolidColorBrush x:Key="WarningBrush" Color="#A86A12" />
    <Color x:Key="DangerColor">#B42F23</Color>
    <SolidColorBrush x:Key="DangerBrush" Color="#B42F23" />
    <Color x:Key="DangerSubtleColor">#12B42F23</Color>
    <SolidColorBrush x:Key="DangerSubtleBrush" Color="#12B42F23" />
    <Color x:Key="InfoColor">#2F6B9A</Color>
    <SolidColorBrush x:Key="InfoBrush" Color="#2F6B9A" />
    <Color x:Key="ShadowColor">#28281F14</Color>
    <SolidColorBrush x:Key="ShadowBrush" Color="#28281F14" />
    <SolidColorBrush x:Key="TransparentBrush" Color="Transparent" />
</ResourceDictionary>
