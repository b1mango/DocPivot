<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:DocPivot.App.Controls">
    <!--
        Control styles for the conversational workspace. Colours are always DynamicResource so
        the theme swaps in place; geometry and type come from Tokens.xaml.
    -->

    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    <c:ResourceGeometryConverter x:Key="ResourceGeometryConverter" />

    <!-- ===== Focus ring: a soft accent outline instead of the dotted rectangle ===== -->
    <Style x:Key="FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-2" BorderBrush="{DynamicResource AccBrush}" BorderThickness="1.5" CornerRadius="10" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Text ===== -->
    <Style x:Key="HeroTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SerifFont}" />
        <Setter Property="FontSize" Value="{StaticResource FontHero}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource T1Brush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="Heading" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SerifFont}" />
        <Setter Property="FontSize" Value="{StaticResource FontHeading}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource T1Brush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="Muted" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSmall}" />
        <Setter Property="Foreground" Value="{DynamicResource T3Brush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="SectionLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontCaption}" />
        <Setter Property="Foreground" Value="{DynamicResource T3Brush}" />
    </Style>

    <Style x:Key="OptionLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource T3Brush}" />
        <Setter Property="Margin" Value="2,0,0,7" />
    </Style>

    <!-- ===== Tooltip ===== -->
    <Style TargetType="ToolTip">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource ToastTextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Margin="6" Padding="9,5" MaxWidth="460" Background="{DynamicResource ToastBrush}" CornerRadius="7">
                        <ContentPresenter>
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Buttons ===== -->
    <Style x:Key="ButtonBase" TargetType="ButtonBase">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource T2Brush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="Chrome"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding c:Ui.CornerRadius}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="False" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Square icon button: 30 × 30, hover fill -->
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="c:Ui.CornerRadius" Value="8" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource T1Brush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource SelBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="RowIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Foreground" Value="{DynamicResource T3Brush}" />
    </Style>

    <Style x:Key="IconToggle" TargetType="ToggleButton" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="c:Ui.CornerRadius" Value="9" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource T1Brush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource SelBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource T1Brush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Window caption buttons, Segoe Fluent glyphs -->
    <Style x:Key="CaptionButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="FontFamily" Value="{StaticResource CaptionGlyphFont}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource T1Brush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource SelBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="CaptionCloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#C42B1C" />
                <Setter Property="Foreground" Value="#FFFFFF" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#B0271A" />
                <Setter Property="Foreground" Value="#FFFFFF" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Ghost chip: text + icon, no outline until hovered -->
    <Style x:Key="GhostChip" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="c:Ui.CornerRadius" Value="9" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource T1Brush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource SelBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Toggle chip: outlined; on = accent tint -->
    <Style x:Key="ToggleChip" TargetType="ToggleButton" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="11,0" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource Line2Brush}" />
        <Setter Property="c:Ui.CornerRadius" Value="9" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource T1Brush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccSoftBrush}" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource AccTextBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Ghost toggle used for the composer's "⋯" popover trigger -->
    <Style x:Key="GhostToggle" TargetType="ToggleButton" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Height" Value="32" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="c:Ui.CornerRadius" Value="9" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource T1Brush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource SelBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource T1Brush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- The composer's send button: accent, 34 tall -->
    <Style x:Key="GoButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Height" Value="34" />
        <Setter Property="MinWidth" Value="34" />
        <Setter Property="Padding" Value="16,0,13,0" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Background" Value="{DynamicResource AccBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnAccBrush}" />
        <Setter Property="c:Ui.CornerRadius" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding c:Ui.CornerRadius}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccHoverBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource WellBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource T3Brush}" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="RoundGoButton" TargetType="Button" BasedOn="{StaticResource GoButton}">
        <Setter Property="Width" Value="34" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="c:Ui.CornerRadius" Value="17" />
    </Style>

    <!-- Outlined secondary button (result card actions) -->
    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="13,0,14,0" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource T1Brush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource Line2Brush}" />
        <Setter Property="c:Ui.CornerRadius" Value="10" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource SelBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Quiet text button -->
    <Style x:Key="TextButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Foreground" Value="{DynamicResource T3Brush}" />
        <Setter Property="c:Ui.CornerRadius" Value="8" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource T1Brush}" />
                <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Action inside the toast pill (dark in light theme, light in dark theme) -->
    <Style x:Key="ToastButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Height" Value="26" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource ToastAccentBrush}" />
        <Setter Property="c:Ui.CornerRadius" Value="6" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource ToastHoverBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Sidebar row for a recent output -->
    <Style x:Key="SidebarRowButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="c:Ui.CornerRadius" Value="8" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource T1Brush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource SelBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SidebarFootButton" TargetType="Button" BasedOn="{StaticResource SidebarRowButton}">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>

    <!-- "继续添加" row under the list -->
    <Style x:Key="AddRowButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Height" Value="44" />
        <Setter Property="Foreground" Value="{DynamicResource T3Brush}" />
        <Setter Property="c:Ui.CornerRadius" Value="12" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource T2Brush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== Lists ===== -->
    <Style x:Key="BareList" TargetType="ListBox">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Cycle" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ItemsPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Sidebar tool -->
    <Style x:Key="NavItem" TargetType="ListBoxItem">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Margin" Value="0,0,0,1" />
        <Setter Property="Foreground" Value="{DynamicResource T2Brush}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Chrome" Padding="10,0" Background="Transparent" CornerRadius="8">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SelBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource T1Brush}" />
                            <Setter Property="FontWeight" Value="Medium" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Starter chip under the hero composer (mode choice) -->
    <Style x:Key="StarterChipItem" TargetType="ListBoxItem">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Margin" Value="4,0" />
        <Setter Property="Foreground" Value="{DynamicResource T2Brush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="Shadow" Margin="1" Background="{DynamicResource CardBrush}" CornerRadius="10" Opacity="0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="4" Direction="270" Opacity="{DynamicResource ShadowSoftOpacity}" ShadowDepth="1" Color="{DynamicResource ShadowSoftColor}" />
                            </Border.Effect>
                        </Border>
                        <Border x:Name="Chrome"
                                Padding="12,0,14,0"
                                Background="{DynamicResource BgBrush}"
                                BorderBrush="{DynamicResource LineBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource CardBrush}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Line2Brush}" />
                            <Setter TargetName="Shadow" Property="Opacity" Value="1" />
                            <Setter Property="Foreground" Value="{DynamicResource T1Brush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Text tabs inside the composer (rename rules) -->
    <Style x:Key="TabItemStyle" TargetType="ListBoxItem">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="Foreground" Value="{DynamicResource T3Brush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Chrome" Height="28" Padding="10,0" Background="Transparent" CornerRadius="7">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource T1Brush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource WellBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource T1Brush}" />
                            <Setter Property="FontWeight" Value="Medium" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Apple-style segmented control: well track, raised card for the choice -->
    <Style x:Key="Segmented" TargetType="ListBox" BasedOn="{StaticResource BareList}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border Padding="3" Background="{DynamicResource WellBrush}" CornerRadius="9">
                        <ItemsPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <Setter Property="OverridesDefaultStyle" Value="True" />
                    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Foreground" Value="{DynamicResource T2Brush}" />
                    <Setter Property="FontSize" Value="13" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Grid>
                                    <Border x:Name="Raise" Background="{DynamicResource CardBrush}" CornerRadius="7" Opacity="0">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="3" Direction="270" Opacity="{DynamicResource ShadowSoftOpacity}" ShadowDepth="1" Color="{DynamicResource ShadowSoftColor}" />
                                        </Border.Effect>
                                    </Border>
                                    <ContentPresenter Margin="10,6" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource T1Brush}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Raise" Property="Opacity" Value="1" />
                                        <Setter Property="Foreground" Value="{DynamicResource T1Brush}" />
                                        <Setter Property="FontWeight" Value="Medium" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Text input: well fill, accent ring on focus. Tag = leading label. ===== -->
    <Style TargetType="TextBox">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="11,0" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Foreground" Value="{DynamicResource T1Brush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource T1Brush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource AccBrush}" />
        <Setter Property="SelectionOpacity" Value="0.3" />
        <Setter Property="Background" Value="{DynamicResource WellBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="None" />
        <Setter Property="AllowDrop" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="Ring" Margin="-3" BorderBrush="{DynamicResource AccSoftBrush}" BorderThickness="3" CornerRadius="12" Opacity="0" />
                        <Border x:Name="Field"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="9">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="Label"
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Center"
                                           FontSize="12.5"
                                           Foreground="{DynamicResource T3Brush}"
                                           Text="{TemplateBinding Tag}" />
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Grid.Column="1"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="{x:Null}">
                            <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource LineBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Field" Property="Background" Value="{DynamicResource CardBrush}" />
                            <Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource AccBrush}" />
                            <Setter TargetName="Ring" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource T2Brush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Borderless inline editor used for a file name inside a row -->
    <Style x:Key="InlineNameBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="7,0" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <!-- ===== CheckBox: 17px rounded box, accent when on ===== -->
    <Style TargetType="CheckBox">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource T1Brush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Box"
                                Width="17"
                                Height="17"
                                VerticalAlignment="Center"
                                BorderBrush="{DynamicResource Line2Brush}"
                                BorderThickness="1.5"
                                CornerRadius="5">
                            <c:Icon x:Name="Tick" Data="{StaticResource PhCheckR}" Size="12" Foreground="{DynamicResource OnAccBrush}" HorizontalAlignment="Center" Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource T3Brush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccBrush}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccBrush}" />
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== ComboBox: well field with a caret; menu-card popup ===== -->
    <Style x:Key="ComboToggle" TargetType="ToggleButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ClickMode" Value="Press" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MenuCard" TargetType="Border">
        <Setter Property="Margin" Value="8,4,8,12" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Background" Value="{DynamicResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="22" Direction="270" Opacity="{DynamicResource ShadowOpacity}" ShadowDepth="6" Color="{DynamicResource ShadowColor}" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="11,0,8,0" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Foreground" Value="{DynamicResource T1Brush}" />
        <Setter Property="Background" Value="{DynamicResource WellBrush}" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="Field" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" CornerRadius="9">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="Label"
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Center"
                                           FontSize="12.5"
                                           Foreground="{DynamicResource T3Brush}"
                                           Text="{TemplateBinding Tag}" />
                                <ContentPresenter Grid.Column="1"
                                                  VerticalAlignment="Center"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                  ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                  IsHitTestVisible="False" />
                                <c:Icon Grid.Column="2" Margin="8,0,0,0" Data="{StaticResource PhCaretDownL}" Size="13" Foreground="{DynamicResource T3Brush}" />
                            </Grid>
                        </Border>
                        <ToggleButton IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Style="{StaticResource ComboToggle}" />
                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               Focusable="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom"
                               PopupAnimation="Fade">
                            <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Style="{StaticResource MenuCard}">
                                <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}" VerticalScrollBarVisibility="Auto">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="{x:Null}">
                            <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Field" Property="Background" Value="{DynamicResource HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Breadcrumb mode switcher: "PDF 工具 › 合并 ⌄" -->
    <Style x:Key="CrumbCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="7,0,6,0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource T1Brush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Chrome" Height="32" Padding="10,0,8,0" Background="Transparent" CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center" />
                            <c:Icon x:Name="Tick" Grid.Column="1" Margin="14,0,0,0" Data="{StaticResource PhCheckR}" Size="14" Foreground="{DynamicResource AccBrush}" Visibility="Hidden" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource T3Brush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Context menu ===== -->
    <Style TargetType="ContextMenu">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border MinWidth="168" Style="{StaticResource MenuCard}">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource T1Brush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Chrome" Height="32" Padding="10,0,14,0" Background="Transparent" CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Content="{TemplateBinding Icon}" />
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" ContentSource="Header" RecognizesAccessKey="False" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource T3Brush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Slider: thin track, accent fill, round thumb ===== -->
    <Style x:Key="SliderRepeat" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Height="4" Background="{TemplateBinding Background}" CornerRadius="2" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Slider">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Track x:Name="PART_Track" VerticalAlignment="Center">
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Background="{DynamicResource AccBrush}" Command="Slider.DecreaseLarge" Style="{StaticResource SliderRepeat}" />
                        </Track.DecreaseRepeatButton>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Background="{DynamicResource WellBrush}" Command="Slider.IncreaseLarge" Style="{StaticResource SliderRepeat}" />
                        </Track.IncreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Grid Width="18" Height="18">
                                            <Ellipse Fill="{DynamicResource CardBrush}" Stroke="{DynamicResource Line2Brush}" StrokeThickness="1">
                                                <Ellipse.Effect>
                                                    <DropShadowEffect BlurRadius="4" Direction="270" Opacity="{DynamicResource ShadowOpacity}" ShadowDepth="1" Color="{DynamicResource ShadowColor}" />
                                                </Ellipse.Effect>
                                            </Ellipse>
                                        </Grid>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== ProgressBar: 4px rail drawn by ProgressFlow (glide, sweep, sparks); the extra height is room for sparks ===== -->
    <Style TargetType="ProgressBar">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Height" Value="10" />
        <Setter Property="Foreground" Value="{DynamicResource AccBrush}" />
        <Setter Property="Background" Value="{DynamicResource WellBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <c:ProgressFlow Fill="{TemplateBinding Foreground}"
                                    IsIndeterminate="{TemplateBinding IsIndeterminate}"
                                    Maximum="{TemplateBinding Maximum}"
                                    Minimum="{TemplateBinding Minimum}"
                                    Track="{TemplateBinding Background}"
                                    Value="{TemplateBinding Value}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== ScrollBar: thin, quiet ===== -->
    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Grip" Width="6" Background="{DynamicResource Line2Brush}" CornerRadius="3" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Grip" Property="Background" Value="{DynamicResource T3Brush}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Grip" Property="Background" Value="{DynamicResource T3Brush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollPage" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Width" Value="10" />
        <Setter Property="MinWidth" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollPage}" />
                        </Track.DecreaseRepeatButton>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollPage}" />
                        </Track.IncreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb Style="{StaticResource ScrollThumb}" />
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== Cards ===== -->
    <!-- Composer / result card: 20px radius, hairline, soft long shadow behind (never on the text layer).
         The caster is inset so its own anti-aliased edge stays hidden under the face; otherwise the two
         identical curves stack into a pale fringe that reads as a square corner on 100 % displays. -->
    <Style x:Key="CardShadow" TargetType="Border">
        <Setter Property="Margin" Value="2" />
        <Setter Property="Background" Value="{DynamicResource CardBrush}" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="26" Direction="270" Opacity="{DynamicResource ShadowOpacity}" ShadowDepth="5" Color="{DynamicResource ShadowColor}" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CardFace" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="20" />
    </Style>
</ResourceDictionary>
