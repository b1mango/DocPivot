<UserControl x:Class="DocPivot.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:DocPivot.App.Views"
             DataContext="{Binding Settings}">
    <Border Background="{StaticResource WorkspaceGlassBrush}">
        <Grid Margin="24,20,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Margin="0,0,12,0"
                        AutomationProperties.Name="返回工作区"
                        Command="{Binding DataContext.CloseSettingsCommand, RelativeSource={RelativeSource AncestorType={x:Type views:WorkspaceView}}}"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTip="返回">
                    <Button.Content>
                        <Path Style="{StaticResource PathIconStyle}"
                              Data="{StaticResource Icon_Close}"
                              Width="15" Height="15"
                              Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button.Content>
                </Button>
                <StackPanel Grid.Column="1">
                    <TextBlock FontFamily="STXingkai"
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Text="设置" />
                    <TextBlock Margin="0,2,0,0"
                               FontSize="11"
                               Foreground="{StaticResource TextTertiaryBrush}"
                               Text="本地环境与引擎检测" />
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="2">
                <TextBlock Style="{StaticResource SectionLabelStyle}"
                           Text="Microsoft Office" />
                <Border Margin="0,8,0,0"
                        Padding="14,12"
                        Background="{StaticResource SurfaceGlassBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource TextTertiaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsWordReady}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Grid.Column="1"
                                       Margin="8,0,0,0"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Text="Word" />
                            <TextBlock Grid.Column="2"
                                       FontFamily="Segoe UI"
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Text="{Binding WordDetail}" />
                        </Grid>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource TextTertiaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsExcelReady}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Grid.Column="1"
                                       Margin="8,0,0,0"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Text="Excel" />
                            <TextBlock Grid.Column="2"
                                       FontFamily="Segoe UI"
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Text="{Binding ExcelDetail}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Margin="0,14,0,0"
                           FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Text="{Binding ProbeSummary}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Grid.Row="3"
                        HorizontalAlignment="Right"
                        Margin="0,16,0,0"
                        Orientation="Horizontal">
                <Button Margin="0,0,8,0"
                        Command="{Binding ProbeCommand}"
                        IsEnabled="{Binding IsNotProbing}"
                        Style="{StaticResource GlassButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource PathIconStyle}"
                              Data="{StaticResource Icon_Search}"
                              Width="13" Height="13"
                              Margin="0,0,6,0"
                              VerticalAlignment="Center"
                              Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        <TextBlock VerticalAlignment="Center"
                                   Text="{Binding ProbeButtonText}" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding DataContext.CloseSettingsCommand, RelativeSource={RelativeSource AncestorType={x:Type views:WorkspaceView}}}"
                        Style="{StaticResource PrimaryButtonStyle}">
                    <TextBlock VerticalAlignment="Center" Text="返回" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
