<Window x:Class="DocPivot.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DocPivot.App.ViewModels"
        mc:Ignorable="d"
        Title="设置 · 文枢 DocPivot"
        Width="440"
        Height="330"
        MinWidth="400"
        MinHeight="300"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource WindowOverlayBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">
    <Grid Margin="22,18,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontFamily="Microsoft YaHei UI"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       Text="设置" />
            <TextBlock Margin="0,4,0,0"
                       FontSize="11"
                       Foreground="{StaticResource TextTertiaryBrush}"
                       Text="本地环境与引擎检测" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,18,0,0">
            <TextBlock Style="{StaticResource SectionLabelStyle}"
                       Text="Microsoft Office" />
            <Border Margin="0,8,0,0"
                    Padding="14,12"
                    Background="{StaticResource SurfaceGlassBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource TextTertiaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsWordReady}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Grid.Column="1"
                                   Margin="8,0,0,0"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Text="Word" />
                        <TextBlock Grid.Column="2"
                                   FontFamily="Segoe UI"
                                   FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="{Binding WordDetail}" />
                    </Grid>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource TextTertiaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsExcelReady}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Grid.Column="1"
                                   Margin="8,0,0,0"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Text="Excel" />
                        <TextBlock Grid.Column="2"
                                   FontFamily="Segoe UI"
                                   FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="{Binding ExcelDetail}" />
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Margin="0,14,0,0"
                       FontSize="11"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Text="{Binding ProbeSummary}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="2"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0"
                    Orientation="Horizontal">
            <Button Margin="0,0,8,0"
                    Command="{Binding ProbeCommand}"
                    IsEnabled="{Binding IsNotProbing}"
                    Style="{StaticResource GlassButtonStyle}">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource PathIconStyle}"
                          Data="{StaticResource Icon_Search}"
                          Width="13" Height="13"
                          Margin="0,0,6,0"
                          VerticalAlignment="Center"
                          Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    <TextBlock VerticalAlignment="Center"
                               Text="{Binding ProbeButtonText}" />
                </StackPanel>
            </Button>
            <Button AutomationProperties.Name="关闭"
                    Click="OnCloseClick"
                    Style="{StaticResource PrimaryButtonStyle}">
                <TextBlock VerticalAlignment="Center" Text="关闭" />
            </Button>
        </StackPanel>
    </Grid>
</Window>
