<UserControl x:Class="DocPivot.App.Views.WorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:DocPivot.App.Views"
             Focusable="False">
    <Border Background="{StaticResource WorkspaceGlassBrush}">
        <Grid>
            <Grid Visibility="{Binding IsWorkspaceVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid Margin="24,20,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto">
                    <RowDefinition.Style>
                        <Style TargetType="RowDefinition">
                            <Setter Property="Height" Value="Auto" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowPdfVisualPreview}" Value="True">
                                    <Setter Property="Height" Value="*" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </RowDefinition.Style>
                </RowDefinition>
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Text="{Binding SelectedTool.Title}" />
                    <TextBlock Margin="0,3,0,0"
                               FontSize="11"
                               Foreground="{StaticResource TextTertiaryBrush}"
                               Text="{Binding SelectedTool.Subtitle}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Margin="0,0,8,0"
                            AutomationProperties.Name="撤销上次重命名"
                            Command="{Binding UndoLastRenameCommand}"
                            ToolTip="撤销上次重命名">
                        <Button.Content>
                            <Path Style="{StaticResource PathIconStyle}"
                                  Data="{StaticResource Icon_Undo}"
                                  Width="15" Height="15"
                                  Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button.Content>
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsBatchRenameTool}" Value="True" />
                                            <Condition Binding="{Binding HasRenameUndo}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Margin="0,0,8,0"
                            AutomationProperties.Name="添加文件夹"
                            Command="{Binding AddRenameFolderCommand}"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="添加文件夹"
                            Visibility="{Binding IsBatchRenameTool, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Button.Content>
                            <Path Style="{StaticResource PathIconStyle}"
                                  Data="{StaticResource Icon_FolderAdd}"
                                  Width="15" Height="15"
                                  Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button.Content>
                    </Button>
                </StackPanel>
            </Grid>

            <Border x:Name="DropZoneShell"
                    Grid.Row="2"
                    Height="110"
                    VerticalAlignment="Top"
                    AllowDrop="True"
                    Background="{StaticResource SurfaceGlassBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    DragEnter="OnDropZoneDragEnter"
                    DragLeave="OnDropZoneDragLeave"
                    DragOver="OnDropZoneDragOver"
                    Drop="OnDropZoneDrop">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowPdfVisualPreview}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Rectangle x:Name="DropZoneStroke"
                               Margin="7"
                               Fill="{StaticResource BorderStrongBrush}"
                               StrokeDashArray="3,4"
                               RadiusX="6"
                               RadiusY="6" />
                    <StackPanel HorizontalAlignment="Center"
                               VerticalAlignment="Top"
                               Margin="0,18,0,0">
                        <Path Style="{StaticResource PathIconStyle}" Data="{StaticResource Icon_Upload}" Width="22" Height="22" Fill="{StaticResource AccentBrush}" />
                        <TextBlock Margin="0,11,0,0"
                                   HorizontalAlignment="Center"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Text="{Binding DropZoneTitle}" />
                        <TextBlock Margin="0,4,0,0"
                                   HorizontalAlignment="Center"
                                   FontFamily="{StaticResource MonoFontFamily}"
                                   FontSize="10"
                                   Foreground="{StaticResource TextTertiaryBrush}"
                                   Text="{Binding SelectedTool.AcceptedFormats}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="2"
                    MinHeight="368"
                    Padding="12,10"
                    Background="{StaticResource FillSubtleBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="{Binding ShowPdfVisualPreview, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="{Binding PdfPreviewStatus}" />
                        <TextBlock Grid.Column="1"
                                   FontFamily="{StaticResource MonoFontFamily}"
                                   FontSize="10"
                                   Foreground="{StaticResource TextTertiaryBrush}"
                                   Text="{Binding PdfVisualSplitSummary}" />
                    </Grid>
                    <Border Grid.Row="1"
                            Margin="0,8,0,0"
                            Padding="10,7"
                            Background="{StaticResource SurfaceGlassBrush}"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <ItemsControl ItemsSource="{Binding Files}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource PathIconStyle}" Data="{StaticResource Icon_Folder}" Width="14" Height="14" Fill="{StaticResource AccentBrush}" />
                                        <TextBlock Margin="8,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   Text="{Binding FileName}" />
                                        <TextBlock Margin="10,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="10"
                                                   Foreground="{StaticResource TextTertiaryBrush}"
                                                   Text="{Binding PdfPageCountText}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                    <ScrollViewer Grid.Row="2"
                                  Margin="0,8,0,0"
                                  HorizontalScrollBarVisibility="Disabled"
                                  PanningMode="VerticalOnly"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding PdfPageThumbnails}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel ItemWidth="182" ItemHeight="196" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button Width="44"
                                                Margin="1,0"
                                                Padding="0"
                                                AutomationProperties.Name="在此拆分 PDF"
                                                Command="{Binding DataContext.TogglePdfCutCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="在此拆分">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Grid Background="Transparent" Width="44" Height="140">
                                                        <Line X1="22" X2="22" Y1="0" Y2="140"
                                                              StrokeThickness="1">
                                                            <Line.Style>
                                                                <Style TargetType="Line">
                                                                    <Setter Property="Fill" Value="{StaticResource BorderStrongBrush}" />
                                                                    <Setter Property="StrokeDashArray" Value="3,4" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsCutBefore}" Value="True">
                                                                            <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                                                                            <Setter Property="StrokeThickness" Value="2" />
                                                                            <Setter Property="StrokeDashArray" Value="{x:Null}" />
                                                                        </DataTrigger>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="Fill" Value="{StaticResource TextSecondaryBrush}" />
                                                                            <Setter Property="StrokeThickness" Value="1.5" />
                                                                        </Trigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Line.Style>
                                                        </Line>
                                                        <Border Width="22"
                                                                Height="22"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                Background="Transparent"
                                                                CornerRadius="11">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Opacity" Value="1" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsCutBefore}" Value="True">
                                                                            <Setter Property="Opacity" Value="0" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <Path Data="{StaticResource Icon_Scissors}" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                  Fill="Transparent" StrokeThickness="1.6"
                                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform">
                                                                <Path.Style>
                                                                    <Style TargetType="Path">
                                                                        <Setter Property="Fill" Value="{StaticResource TextTertiaryBrush}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsCutBefore}" Value="True">
                                                                                <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Path.Style>
                                                            </Path>
                                                        </Border>
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter Property="Opacity" Value="0.4" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <StackPanel Grid.Column="1" Margin="0,0,4,0">
                                            <Border Width="132"
                                                    Height="182"
                                                    Background="White"
                                                    BorderBrush="{StaticResource BorderStrongBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4">
                                                <Image Margin="3"
                                                       Source="{Binding Thumbnail}"
                                                       Stretch="Uniform" />
                                            </Border>
                                            <TextBlock Margin="0,5,0,0"
                                                       HorizontalAlignment="Center"
                                                       FontSize="10"
                                                       Foreground="{StaticResource TextTertiaryBrush}"
                                                       Text="{Binding PageLabel}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Grid Grid.Row="4">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowPdfVisualPreview}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center"
                           Style="{StaticResource SectionLabelStyle}"
                           Text="{Binding QueueSectionTitle}" />
                <TextBlock Grid.Column="1"
                           Margin="0,0,12,0"
                           VerticalAlignment="Center"
                           FontFamily="{StaticResource MonoFontFamily}"
                           FontSize="10"
                           Foreground="{StaticResource TextTertiaryBrush}"
                           Text="{Binding QueueCountText}" />
                <Button Grid.Column="2"
                        AutomationProperties.Name="清空队列"
                        Command="{Binding ClearQueueCommand}"
                        Style="{StaticResource IconButtonStyle}"
                        ToolTip="清空队列"
                        Content="&#xE74D;" />
            </Grid>

            <Grid Grid.Row="6">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowPdfVisualPreview}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Border Background="{StaticResource FillSubtleBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="1"
                                         CornerRadius="8">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasFiles}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Style="{StaticResource PathIconStyle}" Data="{StaticResource Icon_Folder}" Width="18" Height="18" HorizontalAlignment="Center" Fill="{StaticResource TextTertiaryBrush}" />
                        <TextBlock Margin="0,10,0,0"
                                   HorizontalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="队列为空" />
                    </StackPanel>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasFiles}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <ItemsControl ItemsSource="{Binding Files}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8"
                                        Padding="12,9"
                                        MinHeight="62"
                                        CornerRadius="8">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource SurfaceGlassBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsProcessing}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource AccentSubtleBrush}" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid Visibility="{Binding RequiresRenamePreview, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="44" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border Width="34"
                                                    Height="34"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Top"
                                                    Background="{StaticResource AccentSubtleBrush}"
                                                    CornerRadius="7">
                                                <TextBlock HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontFamily="{StaticResource MonoFontFamily}"
                                                           FontSize="9"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource AccentHoverBrush}"
                                                           Text="{Binding ExtensionText}" />
                                            </Border>

                                            <Grid Grid.Column="1" Margin="0,0,12,0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="28" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock VerticalAlignment="Center"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               Text="{Binding FileName}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding FileName}" />
                                                    <TextBlock Grid.Column="1"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               FontFamily="{StaticResource IconFontFamily}"
                                                               FontSize="11"
                                                               Foreground="{StaticResource TextTertiaryBrush}"
                                                               Text="&#xE72A;" />
                                                    <TextBox Grid.Column="2"
                                                             MinWidth="100"
                                                             Padding="9,6"
                                                             AutomationProperties.Name="重命名后的文件名"
                                                             Text="{Binding RenamePreviewName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             ToolTip="{Binding RenamePreviewName}">
                                                        <TextBox.Style>
                                                            <Style TargetType="TextBox" BasedOn="{StaticResource InputTextBoxStyle}">
                                                                <Setter Property="IsReadOnly" Value="True" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding CanEditRenamePreview}" Value="True">
                                                                        <Setter Property="IsReadOnly" Value="False" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBox.Style>
                                                    </TextBox>
                                                </Grid>
                                                <Grid Grid.Row="1" Margin="0,6,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock FontSize="10"
                                                               Foreground="{StaticResource TextTertiaryBrush}"
                                                               Text="{Binding RenameDirectoryText}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding RenameDirectoryText}" />
                                                    <TextBlock Grid.Column="1"
                                                               Margin="10,0,0,0"
                                                               FontSize="10"
                                                               Text="{Binding StatusText}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding RenameWillChange}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource AccentHoverBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding RenameHasIssue}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsSucceeded}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </Grid>

                                            <Button Grid.Column="2"
                                                    Margin="0,0,6,0"
                                                    AutomationProperties.Name="恢复规则计算名称"
                                                    Command="{Binding DataContext.ClearRenameOverrideCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Content="&#xE7A7;"
                                                    Style="{StaticResource IconButtonStyle}"
                                                    ToolTip="恢复规则计算名称"
                                                    Visibility="{Binding IsRenameManuallyEdited, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <Button Grid.Column="3"
                                                    Margin="0,0,6,0"
                                                    AutomationProperties.Name="打开重命名结果"
                                                    Command="{Binding DataContext.OpenResultCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Content="&#xE8A7;"
                                                    Style="{StaticResource IconButtonStyle}"
                                                    ToolTip="打开重命名结果"
                                                    Visibility="{Binding CanOpenResult, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <Button Grid.Column="4"
                                                    AutomationProperties.Name="从重命名预览移除"
                                                    Command="{Binding DataContext.RemoveFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Content="&#xE711;"
                                                    Style="{StaticResource IconButtonStyle}"
                                                    ToolTip="从重命名预览移除" />
                                        </Grid>

                                        <Grid>
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RequiresRenamePreview}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                        <Grid.ColumnDefinitions>
                                             <ColumnDefinition Width="44" />
                                             <ColumnDefinition Width="*" />
                                             <ColumnDefinition Width="76" />
                                             <ColumnDefinition Width="Auto" />
                                             <ColumnDefinition Width="Auto" />
                                             <ColumnDefinition Width="Auto" />
                                             <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Width="34"
                                                Height="34"
                                                HorizontalAlignment="Left"
                                                Background="{StaticResource AccentSubtleBrush}"
                                                CornerRadius="7">
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontFamily="{StaticResource MonoFontFamily}"
                                                       FontSize="9"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource AccentHoverBrush}"
                                                       Text="{Binding ExtensionText}" />
                                        </Border>

                                        <Grid Grid.Column="1" VerticalAlignment="Center">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="16" />
                                            </Grid.RowDefinitions>
                                            <TextBlock FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       Text="{Binding FileName}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding FullPath}" />
                                            <TextBlock Grid.Row="1"
                                                       Margin="0,3,0,0"
                                                       FontSize="10"
                                                       Text="{Binding StatusText}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding StatusText}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsProcessing}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource AccentHoverBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsSucceeded}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Grid Grid.Row="2"
                                                  Margin="0,7,12,1"
                                                  Visibility="{Binding RequiresWorksheetSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="160" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Margin="0,0,7,0"
                                                           VerticalAlignment="Center"
                                                           FontSize="10"
                                                           Foreground="{StaticResource TextTertiaryBrush}"
                                                           Text="范围" />
                                                <ComboBox Grid.Column="1"
                                                          AutomationProperties.Name="Excel 导出范围"
                                                          DisplayMemberPath="DisplayName"
                                                          IsEnabled="{Binding IsWorksheetSelectionEnabled}"
                                                          ItemsSource="{Binding WorksheetOptions}"
                                                          SelectedItem="{Binding SelectedWorksheetOption, Mode=TwoWay}"
                                                          Style="{StaticResource CompactComboBoxStyle}"
                                                          ToolTip="{Binding SelectedWorksheetOption.ToolTip}">
                                                    <ComboBox.ItemContainerStyle>
                                                        <Style TargetType="ComboBoxItem" BasedOn="{StaticResource GlassComboBoxItemStyle}">
                                                            <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
                                                            <Setter Property="ToolTip" Value="{Binding ToolTip}" />
                                                        </Style>
                                                    </ComboBox.ItemContainerStyle>
                                                </ComboBox>
                                                <Button Grid.Column="2"
                                                        Width="28"
                                                        Height="28"
                                                        MinHeight="28"
                                                        Margin="6,0,0,0"
                                                        Padding="0"
                                                        AutomationProperties.Name="重新读取工作表"
                                                        AutomationProperties.HelpText="{Binding WorksheetSelectionStatusText}"
                                                        Command="{Binding DataContext.RetryWorksheetDiscoveryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Content="&#xE72C;"
                                                        FontFamily="{StaticResource IconFontFamily}"
                                                        Style="{StaticResource GlassButtonStyle}"
                                                        ToolTip="重新读取工作表"
                                                        Visibility="{Binding CanRetryWorksheetDiscovery, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                <Button Grid.Column="3"
                                                        Height="28"
                                                        MinHeight="28"
                                                        Margin="6,0,0,0"
                                                        Padding="8,3"
                                                        AutomationProperties.Name="仍导出全部工作表"
                                                        AutomationProperties.HelpText="{Binding WorksheetSelectionStatusText}"
                                                        Command="{Binding DataContext.ConfirmAllWorksheetsFallbackCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Content="导出全部"
                                                        FontSize="10"
                                                        Style="{StaticResource GlassButtonStyle}"
                                                        ToolTip="忽略读取失败并导出整个工作簿"
                                                        Visibility="{Binding CanConfirmAllWorksheetsFallback, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                <TextBlock Grid.Column="4"
                                                           Margin="6,0,0,0"
                                                           VerticalAlignment="Center"
                                                           FontFamily="{StaticResource IconFontFamily}"
                                                           FontSize="12"
                                                           Foreground="{StaticResource WarningBrush}"
                                                           AutomationProperties.Name="工作表读取警告"
                                                           AutomationProperties.HelpText="{Binding WorksheetSelectionStatusText}"
                                                           Text="&#xE7BA;"
                                                           ToolTip="{Binding WorksheetSelectionStatusText}"
                                                           Visibility="{Binding HasWorksheetDiscoveryWarning, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            </Grid>
                                            <Grid Grid.Row="2"
                                                  Margin="0,7,12,1"
                                                  Visibility="{Binding RequiresExcelToolPreflight, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock VerticalAlignment="Center"
                                                           FontSize="10"
                                                           Foreground="{StaticResource TextTertiaryBrush}"
                                                           Text="兼容性" />
                                                <TextBlock Grid.Column="1"
                                                           Margin="7,0,0,0"
                                                           VerticalAlignment="Center"
                                                           FontSize="10"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           Text="{Binding ExcelToolPreflightSummaryText}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding ExcelToolPreflightStatusText}" />
                                                <Button Grid.Column="2"
                                                        Width="28"
                                                        Height="28"
                                                        MinHeight="28"
                                                        Margin="7,0,0,0"
                                                        Padding="0"
                                                        AutomationProperties.Name="重新检查 Excel 兼容性"
                                                        AutomationProperties.HelpText="{Binding ExcelToolPreflightStatusText}"
                                                        Command="{Binding DataContext.RetryExcelToolPreflightCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Content="&#xE72C;"
                                                        FontFamily="{StaticResource IconFontFamily}"
                                                        Style="{StaticResource GlassButtonStyle}"
                                                        ToolTip="重新检查兼容性"
                                                        Visibility="{Binding CanRetryExcelToolPreflight, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                <TextBlock Grid.Column="3"
                                                           Margin="7,0,0,0"
                                                           VerticalAlignment="Center"
                                                           FontFamily="{StaticResource IconFontFamily}"
                                                           FontSize="12"
                                                           Foreground="{StaticResource WarningBrush}"
                                                           AutomationProperties.Name="Excel 兼容性警告"
                                                           AutomationProperties.HelpText="{Binding ExcelToolPreflightStatusText}"
                                                           Text="&#xE7BA;"
                                                           ToolTip="{Binding ExcelToolPreflightStatusText}"
                                                           Visibility="{Binding HasExcelToolPreflightWarning, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            </Grid>
                                            <Grid Grid.Row="2"
                                                  Margin="0,7,12,1"
                                                  Visibility="{Binding RequiresPdfPreflight, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock VerticalAlignment="Center"
                                                           FontFamily="{StaticResource MonoFontFamily}"
                                                           FontSize="10"
                                                           Foreground="{StaticResource TextTertiaryBrush}"
                                                           Text="{Binding PdfPageCountText}" />
                                                <Button Grid.Column="1"
                                                        Width="28"
                                                        Height="28"
                                                        MinHeight="28"
                                                        Margin="7,0,0,0"
                                                        Padding="0"
                                                        AutomationProperties.Name="重新检查 PDF"
                                                        AutomationProperties.HelpText="{Binding PdfPreflightStatusText}"
                                                        Command="{Binding DataContext.RetryPdfPreflightCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Content="&#xE72C;"
                                                        FontFamily="{StaticResource IconFontFamily}"
                                                        Style="{StaticResource GlassButtonStyle}"
                                                        ToolTip="重新检查 PDF"
                                                        Visibility="{Binding CanRetryPdfPreflight, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                <TextBlock Grid.Column="2"
                                                           Margin="7,0,0,0"
                                                           VerticalAlignment="Center"
                                                           FontFamily="{StaticResource IconFontFamily}"
                                                           FontSize="12"
                                                           Foreground="{StaticResource WarningBrush}"
                                                           AutomationProperties.Name="PDF 检查警告"
                                                           AutomationProperties.HelpText="{Binding PdfPreflightStatusText}"
                                                           Text="&#xE7BA;"
                                                           ToolTip="{Binding PdfPreflightStatusText}"
                                                           Visibility="{Binding HasPdfPreflightWarning, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            </Grid>
                                            <Grid Grid.Row="3" Margin="0,4,14,0">
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsProcessing}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ProgressBar Height="4"
                                                             IsIndeterminate="{Binding IsIndeterminateProgress}"
                                                             Maximum="100"
                                                             Value="{Binding ProgressPercent, Mode=OneWay}" />
                                                <TextBlock Grid.Column="1"
                                                           Margin="8,0,0,0"
                                                           VerticalAlignment="Center"
                                                           FontFamily="{StaticResource MonoFontFamily}"
                                                           FontSize="10"
                                                           Foreground="{StaticResource TextSecondaryBrush}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="{Binding ProgressPercent, StringFormat={}{0:0}%}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsIndeterminateProgress}" Value="True">
                                                                    <Setter Property="Text" Value="处理中…" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </Grid>

                                        <TextBlock Grid.Column="2"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Right"
                                                   FontFamily="{StaticResource MonoFontFamily}"
                                                   FontSize="10"
                                                   Foreground="{StaticResource TextTertiaryBrush}"
                                                   Text="{Binding SizeText}" />

                                        <Button Grid.Column="3"
                                                Margin="6,0,0,0"
                                                AutomationProperties.Name="上移工作簿"
                                                Command="{Binding DataContext.MoveFileUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Content="&#xE74A;"
                                                ToolTip="上移工作簿">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.IsMergeOrderingEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                     Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <Button Grid.Column="4"
                                                Margin="6,0,0,0"
                                                AutomationProperties.Name="下移工作簿"
                                                Command="{Binding DataContext.MoveFileDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Content="&#xE74B;"
                                                ToolTip="下移工作簿">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.IsMergeOrderingEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                     Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <Button Grid.Column="5"
                                                Margin="6,0,0,0"
                                                AutomationProperties.Name="打开结果文件"
                                                Command="{Binding DataContext.OpenResultCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="打开结果文件"
                                                Content="&#xE8A7;">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CanOpenResult}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <Button Grid.Column="6"
                                                Margin="6,0,0,0"
                                                AutomationProperties.Name="从队列移除"
                                                Command="{Binding DataContext.RemoveFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource IconButtonStyle}"
                                                ToolTip="从队列移除"
                                                Content="&#xE711;" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
            </Grid>
        </Grid>
        <views:SettingsView Visibility="{Binding IsSettingsOpen, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </Grid>
    </Border>
</UserControl>
