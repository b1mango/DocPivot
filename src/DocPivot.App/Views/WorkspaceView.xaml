<UserControl x:Class="DocPivot.App.Views.WorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:DocPivot.App.Services"
             Focusable="False">
    <UserControl.Resources>
        <!-- Icon glyph that follows its button's foreground -->
        <Style x:Key="ButtonGlyphStyle" TargetType="Path" BasedOn="{StaticResource PathIconStyle}">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        </Style>

        <Style x:Key="HeaderModeListStyle" TargetType="ListBox" BasedOn="{StaticResource SegmentedListBoxStyle}">
            <Setter Property="Margin" Value="12,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource SegmentedListBoxItemStyle}" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Margin="1,0" FontSize="12.5" Text="{Binding Title}" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToastActionButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource SurfaceElevatedBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource ControlFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Wash"
                                    Background="{DynamicResource SurfaceElevatedBrush}"
                                    CornerRadius="6"
                                    Opacity="0" />
                            <StackPanel Margin="10,4" Orientation="Horizontal">
                                <TextBlock FontSize="12.5" FontWeight="SemiBold" Text="撤销" />
                                <TextBlock Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           FontSize="11"
                                           Opacity="0.55"
                                           Text="Ctrl+Z" />
                            </StackPanel>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Wash" Property="Opacity" Value="0.14" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Wash" Property="Opacity" Value="0.24" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatusLineStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <DataTemplate x:Key="FileRowTemplate">
            <Grid x:Name="RowRoot">
                <Border x:Name="Row"
                        Padding="8,9"
                        CornerRadius="8"
                        AutomationProperties.Name="{Binding FileName}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="Transparent" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsProcessing}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasPdfPreflightFailure}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource DangerSubtleBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource DangerSubtleBrush}" />
                                </DataTrigger>
                                <Trigger Property="services:ListMotion.IsLifted" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Position, becomes a grip while the row can be dragged -->
                        <Grid Width="22"
                              Margin="0,0,12,0"
                              VerticalAlignment="Center"
                              Visibility="{Binding DataContext.IsMergeOrderingEnabled, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock x:Name="IndexText"
                                       HorizontalAlignment="Right"
                                       FontSize="{StaticResource FontSizeSmall}"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       AutomationProperties.Name="合并位置"
                                       Text="{Binding QueuePositionText}" />
                            <Path x:Name="Grip"
                                  Width="14"
                                  Height="14"
                                  HorizontalAlignment="Right"
                                  Data="{StaticResource Icon_GripVertical}"
                                  Opacity="0"
                                  Stroke="{DynamicResource TextTertiaryBrush}"
                                  StrokeThickness="1.8"
                                  Style="{StaticResource PathIconStyle}" />
                        </Grid>

                        <!-- Thumbnail: first page for PDFs, a format sheet otherwise -->
                        <Grid Grid.Column="1" Width="30" Height="39" VerticalAlignment="Center">
                            <Border x:Name="FormatSheet"
                                    Background="{DynamicResource FieldBrush}"
                                    BorderBrush="{DynamicResource BorderStrongBrush}"
                                    BorderThickness="1"
                                    CornerRadius="2">
                                <TextBlock Margin="0,0,0,4"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Bottom"
                                           FontSize="8.5"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}"
                                           Text="{Binding ExtensionText}" />
                            </Border>
                            <Border Background="White"
                                    BorderBrush="{DynamicResource BorderStrongBrush}"
                                    BorderThickness="1"
                                    CornerRadius="2"
                                    Visibility="{Binding HasPdfPreview, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Border.ToolTip>
                                    <ToolTip Padding="6">
                                        <Border Background="White">
                                            <Image Width="240"
                                                   Source="{Binding PdfPreview.Thumbnail}"
                                                   Stretch="Uniform"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Border>
                                    </ToolTip>
                                </Border.ToolTip>
                                <Image Source="{Binding PdfPreview.Thumbnail}"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                        </Grid>

                        <!-- Name and quiet status -->
                        <StackPanel x:Name="GenericContent"
                                    Grid.Column="2"
                                    Margin="12,0,10,0"
                                    VerticalAlignment="Center">
                            <TextBlock FontSize="{StaticResource FontSizeBody}"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       LineHeight="19"
                                       LineStackingStrategy="BlockLineHeight"
                                       MaxHeight="38"
                                       Text="{Binding FileName}"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="Wrap"
                                       ToolTip="{Binding FullPath}" />
                            <StackPanel Margin="0,2,0,0" Orientation="Horizontal">
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource StatusLineStyle}">
                                            <Setter Property="Text" Value="{Binding StatusText}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StatusText}" Value="待处理">
                                                    <Setter Property="Text" Value="{Binding SizeText}" />
                                                </DataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding StatusText}" Value="待处理" />
                                                        <Condition Binding="{Binding PdfPreflightState}" Value="Ready" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Text">
                                                        <Setter.Value>
                                                            <MultiBinding StringFormat="{}{0} · {1}">
                                                                <Binding Path="PdfPageCountText" />
                                                                <Binding Path="SizeText" />
                                                            </MultiBinding>
                                                        </Setter.Value>
                                                    </Setter>
                                                </MultiDataTrigger>
                                                <DataTrigger Binding="{Binding IsPdfPreflightLoading}" Value="True">
                                                    <Setter Property="Text" Value="正在检查…" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding HasPdfPreflightFailure}" Value="True">
                                                    <Setter Property="Text" Value="{Binding PdfPreflightStatusText}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsProcessing}" Value="True">
                                                    <Setter Property="Text" Value="{Binding StatusText}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentHoverBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSucceeded}" Value="True">
                                                    <Setter Property="Text" Value="{Binding StatusText}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                                    <Setter Property="Text" Value="{Binding StatusText}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Button Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="重新检查 PDF"
                                        AutomationProperties.HelpText="{Binding PdfPreflightStatusText}"
                                        Command="{Binding DataContext.RetryPdfPreflightCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Content="重新检查"
                                        Style="{StaticResource TextLinkButtonStyle}"
                                        Visibility="{Binding CanRetryPdfPreflight, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <Path Width="12"
                                      Height="12"
                                      Margin="7,0,0,0"
                                      VerticalAlignment="Center"
                                      AutomationProperties.Name="PDF 检查警告"
                                      AutomationProperties.HelpText="{Binding PdfPreflightStatusText}"
                                      Data="{StaticResource Icon_Warning}"
                                      Stroke="{DynamicResource WarningBrush}"
                                      Style="{StaticResource PathIconStyle}"
                                      ToolTip="{Binding PdfPreflightStatusText}"
                                      Visibility="{Binding HasPdfPreflightWarning, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>

                            <!-- Excel export range -->
                            <Grid Margin="0,8,0,1">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="{Binding RequiresWorksheetSelection, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsWorksheetSelectionLoading}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Margin="0,0,8,0" Style="{StaticResource StatusLineStyle}" Text="范围" />
                                <ComboBox Grid.Column="1"
                                          AutomationProperties.Name="Excel 导出范围"
                                          DisplayMemberPath="DisplayName"
                                          IsEnabled="{Binding IsWorksheetSelectionEnabled}"
                                          ItemsSource="{Binding WorksheetOptions}"
                                          SelectedItem="{Binding SelectedWorksheetOption, Mode=TwoWay}"
                                          Style="{StaticResource CompactComboBoxStyle}"
                                          ToolTip="{Binding SelectedWorksheetOption.ToolTip}">
                                    <ComboBox.ItemContainerStyle>
                                        <Style TargetType="ComboBoxItem" BasedOn="{StaticResource GlassComboBoxItemStyle}">
                                            <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
                                            <Setter Property="ToolTip" Value="{Binding ToolTip}" />
                                        </Style>
                                    </ComboBox.ItemContainerStyle>
                                </ComboBox>
                                <Button Grid.Column="2"
                                        Margin="6,0,0,0"
                                        AutomationProperties.Name="重新读取工作表"
                                        AutomationProperties.HelpText="{Binding WorksheetSelectionStatusText}"
                                        Command="{Binding DataContext.RetryWorksheetDiscoveryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource CompactIconButtonStyle}"
                                        ToolTip="重新读取工作表"
                                        Visibility="{Binding CanRetryWorksheetDiscovery, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Path Width="13" Height="13" Data="{StaticResource Icon_Refresh}" Style="{StaticResource ButtonGlyphStyle}" />
                                </Button>
                                <Button Grid.Column="3"
                                        Margin="6,0,0,0"
                                        AutomationProperties.Name="仍导出全部工作表"
                                        AutomationProperties.HelpText="{Binding WorksheetSelectionStatusText}"
                                        Command="{Binding DataContext.ConfirmAllWorksheetsFallbackCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Content="导出全部"
                                        Style="{StaticResource CompactButtonStyle}"
                                        ToolTip="忽略读取失败并导出整个工作簿"
                                        Visibility="{Binding CanConfirmAllWorksheetsFallback, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <Path Grid.Column="4"
                                      Width="12"
                                      Height="12"
                                      Margin="7,0,0,0"
                                      VerticalAlignment="Center"
                                      AutomationProperties.Name="工作表读取警告"
                                      AutomationProperties.HelpText="{Binding WorksheetSelectionStatusText}"
                                      Data="{StaticResource Icon_Warning}"
                                      Stroke="{DynamicResource WarningBrush}"
                                      Style="{StaticResource PathIconStyle}"
                                      ToolTip="{Binding WorksheetSelectionStatusText}"
                                      Visibility="{Binding HasWorksheetDiscoveryWarning, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </Grid>

                            <!-- Excel compatibility -->
                            <Grid Margin="0,6,0,1">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="{Binding RequiresExcelToolPreflight, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsExcelToolPreflightLoading}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource StatusLineStyle}"
                                           Text="{Binding ExcelToolPreflightSummaryText}"
                                           ToolTip="{Binding ExcelToolPreflightStatusText}" />
                                <Button Grid.Column="1"
                                        Margin="6,0,0,0"
                                        AutomationProperties.Name="重新检查 Excel 兼容性"
                                        AutomationProperties.HelpText="{Binding ExcelToolPreflightStatusText}"
                                        Command="{Binding DataContext.RetryExcelToolPreflightCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource CompactIconButtonStyle}"
                                        ToolTip="重新检查兼容性"
                                        Visibility="{Binding CanRetryExcelToolPreflight, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Path Width="13" Height="13" Data="{StaticResource Icon_Refresh}" Style="{StaticResource ButtonGlyphStyle}" />
                                </Button>
                                <Path Grid.Column="2"
                                      Width="12"
                                      Height="12"
                                      Margin="7,0,0,0"
                                      VerticalAlignment="Center"
                                      AutomationProperties.Name="Excel 兼容性警告"
                                      AutomationProperties.HelpText="{Binding ExcelToolPreflightStatusText}"
                                      Data="{StaticResource Icon_Warning}"
                                      Stroke="{DynamicResource WarningBrush}"
                                      Style="{StaticResource PathIconStyle}"
                                      ToolTip="{Binding ExcelToolPreflightStatusText}"
                                      Visibility="{Binding HasExcelToolPreflightWarning, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </Grid>

                            <!-- Progress while this file is running -->
                            <Grid Margin="0,7,0,0">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsProcessing}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ProgressBar Height="3"
                                             VerticalAlignment="Center"
                                             IsIndeterminate="{Binding IsIndeterminateProgress}"
                                             Maximum="100"
                                             Value="{Binding ProgressPercent, Mode=OneWay}" />
                                <TextBlock Grid.Column="1"
                                           MinWidth="34"
                                           Margin="8,0,0,0"
                                           TextAlignment="Right">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource StatusLineStyle}">
                                            <Setter Property="Text" Value="{Binding ProgressPercent, StringFormat={}{0:0}%}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsIndeterminateProgress}" Value="True">
                                                    <Setter Property="Text" Value="处理中…" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </StackPanel>

                        <!-- Batch rename: original → editable target -->
                        <StackPanel x:Name="RenameContent"
                                    Grid.Column="2"
                                    Margin="12,0,10,0"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center"
                                           FontSize="{StaticResource FontSizeBody}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="{Binding FileName}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding FullPath}" />
                                <Path Grid.Column="1"
                                      Width="13"
                                      Height="13"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Data="{StaticResource Icon_ArrowRight}"
                                      Stroke="{DynamicResource TextTertiaryBrush}"
                                      Style="{StaticResource PathIconStyle}" />
                                <TextBox Grid.Column="2"
                                         Height="30"
                                         MinWidth="100"
                                         Padding="8,0"
                                         AutomationProperties.Name="重命名后的文件名"
                                         Text="{Binding RenamePreviewName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="{Binding RenamePreviewName}">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox" BasedOn="{StaticResource InputTextBoxStyle}">
                                            <Setter Property="IsReadOnly" Value="True" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CanEditRenamePreview}" Value="True">
                                                    <Setter Property="IsReadOnly" Value="False" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                            </Grid>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource StatusLineStyle}"
                                           Text="{Binding RenameDirectoryText}"
                                           ToolTip="{Binding RenameDirectoryText}" />
                                <TextBlock Grid.Column="1" Margin="10,0,0,0" Text="{Binding StatusText}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource StatusLineStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RenameWillChange}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentHoverBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RenameHasIssue}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSucceeded}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </StackPanel>

                        <!-- Row actions, revealed on hover or focus -->
                        <StackPanel x:Name="Actions"
                                    Grid.Column="3"
                                    VerticalAlignment="Center"
                                    Opacity="0"
                                    Orientation="Horizontal">
                            <Button AutomationProperties.Name="顺时针旋转此文件"
                                    Command="{Binding DataContext.RotatePdfFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource CompactIconButtonStyle}"
                                    ToolTip="顺时针旋转"
                                    Visibility="{Binding DataContext.IsPdfMergeMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Path Data="{StaticResource Icon_RotateCw}" Style="{StaticResource ButtonGlyphStyle}" />
                            </Button>
                            <Button AutomationProperties.Name="恢复规则计算名称"
                                    Command="{Binding DataContext.ClearRenameOverrideCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource CompactIconButtonStyle}"
                                    ToolTip="恢复按规则生成的名称"
                                    Visibility="{Binding IsRenameManuallyEdited, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Path Data="{StaticResource Icon_Undo}" Style="{StaticResource ButtonGlyphStyle}" />
                            </Button>
                            <Button AutomationProperties.Name="打开结果文件"
                                    Command="{Binding DataContext.OpenResultCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource CompactIconButtonStyle}"
                                    ToolTip="打开结果"
                                    Visibility="{Binding CanOpenResult, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Path Data="{StaticResource Icon_Open}" Style="{StaticResource ButtonGlyphStyle}" />
                            </Button>
                            <Button AutomationProperties.Name="从队列移除"
                                    Command="{Binding DataContext.RemoveFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource CompactIconButtonStyle}"
                                    ToolTip="移除（可撤销）">
                                <Path Data="{StaticResource Icon_Close}" Style="{StaticResource ButtonGlyphStyle}" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
                <Rectangle x:Name="Hairline"
                           Height="1"
                           Margin="8,0"
                           VerticalAlignment="Bottom"
                           Fill="{DynamicResource BorderSubtleBrush}"
                           IsHitTestVisible="False" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding RequiresRenamePreview}" Value="True">
                    <Setter TargetName="GenericContent" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="RenameContent" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasPdfPreview}" Value="True">
                    <Setter TargetName="FormatSheet" Property="Visibility" Value="Hidden" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsMouseOver, ElementName=Row}" Value="True" />
                        <Condition Binding="{Binding DataContext.CanReorderFiles, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="IndexText" Property="Opacity" Value="0" />
                    <Setter TargetName="Grip" Property="Opacity" Value="1" />
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=Row}" Value="True">
                    <Setter TargetName="Actions" Property="Opacity" Value="1" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMouseOver, ElementName=Row}" Value="True">
                    <Setter TargetName="Hairline" Property="Opacity" Value="0" />
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Actions"
                                                 Storyboard.TargetProperty="Opacity"
                                                 To="1"
                                                 Duration="{StaticResource HoverFadeDuration}" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Actions"
                                                 Storyboard.TargetProperty="Opacity"
                                                 FillBehavior="Stop"
                                                 To="0"
                                                 Duration="{StaticResource HoverFadeDuration}" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
                <DataTrigger Binding="{Binding (services:ListMotion.IsLifted), ElementName=Row}" Value="True">
                    <Setter TargetName="Hairline" Property="Opacity" Value="0" />
                    <Setter TargetName="IndexText" Property="Opacity" Value="0" />
                    <Setter TargetName="Grip" Property="Opacity" Value="1" />
                    <Setter TargetName="Grip" Property="Stroke" Value="{DynamicResource TextSecondaryBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Split view: one page card with a cut slot before it -->
        <DataTemplate x:Key="PageThumbnailTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Width="44"
                        Margin="1,0"
                        Padding="0"
                        AutomationProperties.Name="在此拆分 PDF"
                        Command="{Binding DataContext.TogglePdfCutCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}"
                        Cursor="Hand"
                        ToolTip="在此拆分">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid Width="44" Height="182" Background="Transparent">
                                <Line x:Name="CutLine"
                                      X1="22" X2="22" Y1="8" Y2="174"
                                      Stroke="{DynamicResource BorderStrongBrush}"
                                      StrokeDashArray="3,4"
                                      StrokeThickness="1" />
                                <Border x:Name="CutBadge"
                                        Width="24"
                                        Height="24"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource SurfaceGlassBrush}"
                                        CornerRadius="12">
                                    <Path x:Name="CutGlyph"
                                          Width="13"
                                          Height="13"
                                          Data="{StaticResource Icon_Scissors}"
                                          Stroke="{DynamicResource TextTertiaryBrush}"
                                          Style="{StaticResource PathIconStyle}" />
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="CutLine" Property="Stroke" Value="{DynamicResource TextSecondaryBrush}" />
                                    <Setter TargetName="CutGlyph" Property="Stroke" Value="{DynamicResource TextSecondaryBrush}" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsCutBefore}" Value="True">
                                    <Setter TargetName="CutLine" Property="Stroke" Value="{DynamicResource AccentBrush}" />
                                    <Setter TargetName="CutLine" Property="StrokeThickness" Value="2" />
                                    <Setter TargetName="CutLine" Property="StrokeDashArray" Value="{x:Null}" />
                                    <Setter TargetName="CutGlyph" Property="Stroke" Value="{DynamicResource AccentBrush}" />
                                </DataTrigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <StackPanel Grid.Column="1" Margin="0,0,4,0">
                    <Border Width="132"
                            Height="182"
                            Background="White"
                            BorderBrush="{DynamicResource BorderStrongBrush}"
                            BorderThickness="1"
                            CornerRadius="3">
                        <Grid ClipToBounds="True">
                            <Image Margin="3"
                                   Source="{Binding Thumbnail}"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <Button Width="26"
                                    Height="26"
                                    Margin="0,5,5,0"
                                    Padding="0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Background="#88000000"
                                    BorderBrush="#66FFFFFF"
                                    BorderThickness="1"
                                    AutomationProperties.Name="旋转文件"
                                    Command="{Binding DataContext.RotatePdfPageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    ToolTip="顺时针旋转此文件"
                                    Visibility="{Binding DataContext.ShowPdfMergeOutputName, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Path Width="14"
                                      Height="14"
                                      Data="{StaticResource Icon_RotateCw}"
                                      Stroke="White"
                                      StrokeThickness="1.7"
                                      Style="{StaticResource PathIconStyle}" />
                            </Button>
                        </Grid>
                    </Border>
                    <TextBlock Margin="0,6,0,0"
                               HorizontalAlignment="Center"
                               FontSize="{StaticResource FontSizeCaption}"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               Text="{Binding DisplayLabel}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding DisplayLabel}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <Grid Visibility="{Binding IsWorkspaceVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header: tool, one quiet summary line, mode switch -->
            <Grid Margin="26,22,26,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="{StaticResource FontSizeTitle}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Text="{Binding SelectedTool.Title}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock MinHeight="17"
                               Margin="0,3,0,0"
                               FontSize="12.5"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               Text="{Binding HeaderSummary}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                    <Button Margin="0,0,6,0"
                            AutomationProperties.Name="恢复中断的重命名"
                            Command="{Binding RecoverInterruptedRenameCommand}"
                            Content="{Binding RenameRecoveryText}"
                            Style="{StaticResource CompactButtonStyle}"
                            ToolTip="将中断事务中的文件恢复为原名；存在冲突时停止并保留恢复记录"
                            Visibility="{Binding HasPendingRenameRecovery, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Button Margin="0,0,2,0"
                            AutomationProperties.Name="撤销上次重命名"
                            Command="{Binding UndoLastRenameCommand}"
                            ToolTip="撤销上次重命名">
                        <Path Data="{StaticResource Icon_Undo}" Style="{StaticResource ButtonGlyphStyle}" />
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsBatchRenameTool}" Value="True" />
                                            <Condition Binding="{Binding HasRenameUndo}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Margin="0,0,2,0"
                            AutomationProperties.Name="添加文件夹"
                            Command="{Binding AddRenameFolderCommand}"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="添加文件夹"
                            Visibility="{Binding IsBatchRenameTool, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Path Data="{StaticResource Icon_FolderAdd}" Style="{StaticResource ButtonGlyphStyle}" />
                    </Button>
                    <Button AutomationProperties.Name="清空队列"
                            Command="{Binding ClearQueueCommand}"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="清空列表"
                            Visibility="{Binding HasFiles, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Path Data="{StaticResource Icon_Trash}" Style="{StaticResource ButtonGlyphStyle}" />
                    </Button>
                    <ListBox AutomationProperties.Name="Excel 处理方式"
                             IsEnabled="{Binding IsNotProcessing}"
                             ItemsSource="{Binding ExcelToolModes}"
                             SelectedItem="{Binding SelectedExcelToolMode, Mode=TwoWay}"
                             Style="{StaticResource HeaderModeListStyle}"
                             Visibility="{Binding IsExcelOperationsTool, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <ListBox AutomationProperties.Name="PDF 处理方式"
                             IsEnabled="{Binding IsNotProcessing}"
                             ItemsSource="{Binding PdfToolModes}"
                             SelectedItem="{Binding SelectedPdfToolMode, Mode=TwoWay}"
                             Style="{StaticResource HeaderModeListStyle}"
                             Visibility="{Binding IsPdfOperationsTool, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <ListBox AutomationProperties.Name="批量重命名方式"
                             IsEnabled="{Binding IsNotProcessing}"
                             ItemsSource="{Binding RenameToolModes}"
                             SelectedItem="{Binding SelectedRenameToolMode, Mode=TwoWay}"
                             Style="{StaticResource HeaderModeListStyle}"
                             Visibility="{Binding IsBatchRenameTool, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
            </Grid>

            <!-- Content: the whole area accepts drops -->
            <Grid x:Name="DropHost"
                  Grid.Row="1"
                  AllowDrop="True"
                  Background="Transparent"
                  DragEnter="OnDropZoneDragEnter"
                  DragLeave="OnDropZoneDragLeave"
                  DragOver="OnDropZoneDragOver"
                  Drop="OnDropZoneDrop">

                <!-- Empty state -->
                <Border x:Name="DropZoneShell"
                        Margin="26,0,26,26"
                        CornerRadius="10"
                        Cursor="Hand"
                        MouseLeftButtonUp="OnDropZoneMouseLeftButtonUp">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource DropZoneBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasFiles}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Rectangle x:Name="DropZoneStroke"
                                   RadiusX="10"
                                   RadiusY="10"
                                   Stroke="{DynamicResource BorderStrongBrush}"
                                   StrokeDashArray="4,3"
                                   StrokeThickness="1.2" />
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Width="26"
                                  Height="26"
                                  HorizontalAlignment="Center"
                                  Data="{StaticResource Icon_Upload}"
                                  Stroke="{DynamicResource TextSecondaryBrush}"
                                  StrokeThickness="1.5"
                                  Style="{StaticResource PathIconStyle}" />
                            <TextBlock Margin="0,14,0,0"
                                       HorizontalAlignment="Center"
                                       FontSize="14"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Text="{Binding DropZoneTitle}" />
                            <TextBlock Margin="0,6,0,0"
                                       HorizontalAlignment="Center"
                                       FontSize="{StaticResource FontSizeSmall}"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       Text="{Binding SelectedTool.AcceptedFormats}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Files -->
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding HasFiles, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Margin="18,0,18,72">
                        <ItemsControl x:Name="FileList"
                                      AutomationProperties.Name="合并顺序"
                                      Focusable="False"
                                      ItemTemplate="{StaticResource FileRowTemplate}"
                                      ItemsSource="{Binding Files}"
                                      services:ListMotion.CanReorder="{Binding CanReorderFiles}"
                                      services:ListMotion.IsEnabled="True" />

                        <Border x:Name="AddRow"
                                Margin="8,6,8,0"
                                CornerRadius="8"
                                Cursor="Hand"
                                MouseLeftButtonUp="OnDropZoneMouseLeftButtonUp">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsProcessing}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Rectangle x:Name="AddRowStroke"
                                           RadiusX="8"
                                           RadiusY="8"
                                           Stroke="{DynamicResource BorderStrongBrush}"
                                           StrokeDashArray="4,3"
                                           StrokeThickness="1" />
                                <StackPanel Margin="0,10" HorizontalAlignment="Center" Orientation="Horizontal">
                                    <Path Width="12"
                                          Height="12"
                                          VerticalAlignment="Center"
                                          Data="{StaticResource Icon_Plus}"
                                          Stroke="{DynamicResource TextTertiaryBrush}"
                                          Style="{StaticResource PathIconStyle}" />
                                    <TextBlock Margin="7,0,0,0"
                                               VerticalAlignment="Center"
                                               FontSize="12.5"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               Text="{Binding AddRowText}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Split: pages with cut slots -->
                        <StackPanel Margin="8,26,0,0"
                                    Visibility="{Binding ShowPageThumbnails, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center"
                                           FontSize="{StaticResource FontSizeSmall}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="{Binding PdfPreviewStatus}"
                                           TextTrimming="CharacterEllipsis" />
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            Visibility="{Binding ShowPdfPreviewPagination, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Button AutomationProperties.Name="查看上一批 PDF 页面"
                                            Command="{Binding PreviousPdfPreviewBatchCommand}"
                                            Content="上一批"
                                            Style="{StaticResource CompactButtonStyle}" />
                                    <TextBlock Margin="10,0"
                                               VerticalAlignment="Center"
                                               FontSize="{StaticResource FontSizeSmall}"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               Text="{Binding PdfPreviewPageRange}" />
                                    <Button AutomationProperties.Name="查看下一批 PDF 页面"
                                            Command="{Binding NextPdfPreviewBatchCommand}"
                                            Content="下一批"
                                            Style="{StaticResource CompactButtonStyle}" />
                                </StackPanel>
                            </Grid>
                            <ItemsControl Focusable="False"
                                          ItemTemplate="{StaticResource PageThumbnailTemplate}"
                                          ItemsSource="{Binding PdfPageThumbnails}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel ItemHeight="216" ItemWidth="182" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Undo removal -->
            <Border Grid.Row="1"
                    Margin="0,0,0,22"
                    Padding="16,6,6,6"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Background="{DynamicResource TextPrimaryBrush}"
                    CornerRadius="8"
                    AutomationProperties.LiveSetting="Polite"
                    AutomationProperties.Name="{Binding UndoableRemovalText}">
                <Border.RenderTransform>
                    <TranslateTransform />
                </Border.RenderTransform>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasUndoableRemoval}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="0"
                                                             To="1"
                                                             Duration="{StaticResource MoveDuration}" />
                                            <DoubleAnimation EasingFunction="{StaticResource EaseOut}"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                             From="10"
                                                             To="0"
                                                             Duration="{StaticResource MoveDuration}" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <TextBlock MaxWidth="360"
                               VerticalAlignment="Center"
                               FontSize="12.5"
                               Foreground="{DynamicResource SurfaceElevatedBrush}"
                               Text="{Binding UndoableRemovalText}"
                               TextTrimming="CharacterEllipsis" />
                    <Button Margin="12,0,0,0"
                            AutomationProperties.Name="撤销移除"
                            Command="{Binding UndoRemoveCommand}"
                            Style="{StaticResource ToastActionButtonStyle}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
